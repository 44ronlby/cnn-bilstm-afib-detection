
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Python Virtual Environments
venv/
.venv/
env/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Data Files (Do NOT commit raw/processed ECG signals)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.npy
*.csv
*.dat
*.hea
*.atr

# Model Weights & Artifacts
saved_models/*
!saved_models/.gitkeep
*.keras
*.h5
*.pkl
*.ckpt

# Output Figures
outputs/*
!outputs/.gitkeep

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment variables & secrets
.env
